<UserControl x:Class="MemoriesDemo.ViewTemplates.PageTemplate_Scrap_1"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="700" d:DesignWidth="700">
    <UserControl.Resources>

    </UserControl.Resources>

    <Grid>
        <Grid x:Name="_layoutRoot" Margin="0,0,0,0">
            <Viewbox>
                <Grid Background="Transparent" Margin="0">
                    <Grid x:Name="_1_panel_Img" Width="700" Height="700" />
                    <Image Source="/Assets/Template02_Page01.png" 
                       x:Name="_imgBackground"
                       Stretch="UniformToFill"
                       IsHitTestVisible="False"
                       HorizontalAlignment="Left"
                       Width="550" Height="550"
                       VerticalAlignment="Top"/>
                    <Grid x:Name="_1_tb_Desc"
                      Width="400"
                      Margin="42,10,60,0" 
                      VerticalAlignment="Top"
                      HorizontalAlignment="Left">
                        <Grid.Tag>
                            <TextBlock Foreground="#FFFF7D00" FontSize="40" Width="500" TextWrapping="NoWrap" />
                        </Grid.Tag>
                    </Grid>
                    <Grid x:Name="_2_tb_Desc"
                      Margin="83,124,328,0" 
                      VerticalAlignment="Top" 
                      HorizontalAlignment="Left">
                        <Grid.Tag>
                            <TextBlock Foreground="White" FontSize="18" Width="200" TextWrapping="Wrap" />
                        </Grid.Tag>
                    </Grid>
                </Grid>
            </Viewbox>
        </Grid>

        <Canvas x:Name="_propsView" />
        <Canvas x:Name="_canvas_LargeView" Background="Transparent" IsHitTestVisible="False" />
    </Grid>
</UserControl>

