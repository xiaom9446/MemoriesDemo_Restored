<UserControl x:Class="MemoriesDemo.ViewTemplates.PageTemplate_Basic_7"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="700" d:DesignWidth="700">
    <UserControl.Resources>

    </UserControl.Resources>

    <Grid>
        <Grid x:Name="_layoutRoot" Margin="0,0,0,0">
            <Viewbox>
                <Grid Background="Transparent" Margin="0" Height="700" Width="700">
                    <Grid x:Name="_1_panel_Img" Height="700" VerticalAlignment="Top" HorizontalAlignment="Right" Width="350" />
                    <Rectangle Stretch="Fill" Fill="#FFFF7D00" Height="700" VerticalAlignment="Bottom" Width="350" d:LayoutOverrides="Width" HorizontalAlignment="Left"/>
                    <Rectangle Stretch="Fill" Fill="White" Margin="348,0"/>
                    <Grid x:Name="_1_tb_Desc" Width="600" Margin="-400.883,164.117,422.117,0" RenderTransformOrigin="0.5,0.5" VerticalAlignment="Top" HorizontalAlignment="Left">
                        <Grid.Tag>
                            <TextBlock Foreground="White" FontSize="30" Width="600" TextWrapping="NoWrap" />
                        </Grid.Tag>
                        <Grid.RenderTransform>
                            <CompositeTransform Rotation="-90"/>
                        </Grid.RenderTransform>
                    </Grid>
                </Grid>
            </Viewbox>
        </Grid>

        <Canvas x:Name="_propsView" />
        <Canvas x:Name="_canvas_LargeView" Background="Transparent" IsHitTestVisible="False" />
    </Grid>
</UserControl>

