<UserControl x:Class="MemoriesDemo.ViewTemplates.PageTemplate_Basic_2"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="700" d:DesignWidth="700">
    <UserControl.Resources>

    </UserControl.Resources>

    <Grid>
        <Grid x:Name="_layoutRoot" Margin="0,0,0,0">
            <Viewbox>
                <Grid Background="Transparent" Margin="0">
                    <Grid x:Name="_1_panel_Img" Width="700" Height="700" />
                    <Rectangle Stretch="Fill" Fill="#FFFF7D00" Height="188" VerticalAlignment="Top"/>
                    <Grid x:Name="_1_tb_Desc" Width="600" Margin="56,27,0,0" VerticalAlignment="Top" HorizontalAlignment="Left">
                        <Grid.Tag>
                            <TextBlock Foreground="White" FontSize="40" Height="100" Width="600" TextWrapping="NoWrap" />
                        </Grid.Tag>
                    </Grid>
                    <Rectangle Stretch="Fill" Fill="White" Height="4" VerticalAlignment="Top" Margin="0,188,0,0"/>
                </Grid>
            </Viewbox>
        </Grid>

        <Canvas x:Name="_propsView" />
        <Canvas x:Name="_canvas_LargeView" Background="Transparent" IsHitTestVisible="False" />
    </Grid>
</UserControl>

