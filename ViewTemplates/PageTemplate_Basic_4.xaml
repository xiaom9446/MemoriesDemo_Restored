<UserControl x:Class="MemoriesDemo.ViewTemplates.PageTemplate_Basic_4"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="700" d:DesignWidth="700">
    <UserControl.Resources>

    </UserControl.Resources>

    <Grid>
        <Grid x:Name="_layoutRoot" Margin="0,0,0,0">
            <Viewbox>
                <Grid Background="Transparent" Margin="0" Height="700" Width="700">
                    <Grid x:Name="_1_panel_Img" HorizontalAlignment="Left" Height="350" VerticalAlignment="Top" Width="350" />
                    <Grid x:Name="_2_panel_Img" Height="350" VerticalAlignment="Top" HorizontalAlignment="Right" Width="350" />
                    <Grid x:Name="_3_panel_Img" HorizontalAlignment="Left" Width="350" Height="350" VerticalAlignment="Bottom" />
                    <Grid x:Name="_4_panel_Img" HorizontalAlignment="Right" Width="350" Height="350" VerticalAlignment="Bottom" />
                    <Rectangle Stretch="Fill" Fill="#FFFF7D00" Height="350" VerticalAlignment="Bottom" Width="350" HorizontalAlignment="Left"/>
                    <Rectangle Stretch="Fill" Fill="White" Margin="0,348" />
                    <Rectangle Stretch="Fill" Fill="White" Margin="348,0" />
                    <Grid x:Name="_1_tb_Desc" Width="400" Margin="20,370,370,20" Height="88" VerticalAlignment="Bottom" HorizontalAlignment="Left">
                        <Grid.Tag>
                            <TextBlock Foreground="White" FontSize="40" Width="400" TextWrapping="NoWrap" />
                        </Grid.Tag>
                    </Grid>
                </Grid>
            </Viewbox>
        </Grid>

        <Canvas x:Name="_propsView" />
        <Canvas x:Name="_canvas_LargeView" Background="Transparent" IsHitTestVisible="False" />
    </Grid>
</UserControl>

