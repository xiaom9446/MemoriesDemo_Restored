<Page x:Class="MemoriesDemo.Views.AlbumDetailsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:MemoriesDemo.Views"
      xmlns:helpers="using:MemoriesDemo.Helpers"
      Background="Transparent">

    <Page.Resources>
        <helpers:DateConverter x:Key="DateConverter"/>

        <Storyboard x:Name="sb_TransitionIn">
            <DoubleAnimation From="0" To="1" Duration="0:0:0.5"
                             Storyboard.TargetName="LayoutRoot" Storyboard.TargetProperty="Opacity">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Name="sb_TransitionOut">
            <DoubleAnimation From="1" To="0" Duration="0:0:0.25"
                             Storyboard.TargetName="LayoutRoot" Storyboard.TargetProperty="Opacity">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- 只淡入淡出，不做位移：即使 Storyboard 未执行，AppBar 也一定可见 -->
        <Storyboard x:Name="sb_AppBarIn">
            <DoubleAnimation Storyboard.TargetName="_appbar"
                             Storyboard.TargetProperty="(UIElement.Opacity)"
                             From="0" To="1" Duration="0:0:0.15"/>
        </Storyboard>

        <Storyboard x:Name="sb_AppBarOut">
            <DoubleAnimation Storyboard.TargetName="_appbar"
                             Storyboard.TargetProperty="(UIElement.Opacity)"
                             From="1" To="0" Duration="0:0:0.12"/>
        </Storyboard>

        <!-- AppBar 图标按钮：圆圈 + 图形 + 下方文字（Tag 放图形，Content 放文字） -->
        <Style x:Key="AppBarBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="104"/>
            <Setter Property="Height" Value="76"/>
            <Setter Property="Margin" Value="4,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="MouseOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ringBrush"
                                                             Storyboard.TargetProperty="Opacity"
                                                             Duration="0:0:0.15" To="0.45"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ringBrush"
                                                             Storyboard.TargetProperty="Opacity"
                                                             Duration="0" To="0.7"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="rootContent"
                                                             Storyboard.TargetProperty="Opacity"
                                                             Duration="0" To="0.3"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <StackPanel x:Name="rootContent" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Grid Width="40" Height="40" HorizontalAlignment="Center">
                                    <Ellipse x:Name="ringBrush" Stroke="White" StrokeThickness="1.6" Opacity="0.9"/>
                                    <TextBlock Text="{TemplateBinding Tag}"
                                               FontFamily="Segoe UI Symbol" FontSize="17"
                                               Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="{TemplateBinding Content}"
                                           Foreground="White" FontSize="12"
                                           FontFamily="Segoe UI"
                                           HorizontalAlignment="Center" Margin="0,7,0,0"/>
                            </StackPanel>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 浏览/编辑态：整页铺满，按窗口高度自适应 -->
        <Style x:Key="PageItemContainerStyle" TargetType="GridViewItem">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>

        <!-- 重排态：同一批页面缩小成缩略图（页面模板内部有 Viewbox，会自动等比缩放） -->
        <Style x:Key="ReorderItemContainerStyle" TargetType="GridViewItem">
            <Setter Property="Width" Value="320"/>
            <Setter Property="Height" Value="320"/>
            <Setter Property="Margin" Value="12,24,12,12"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>
    </Page.Resources>

    <Grid x:Name="LayoutRoot" Background="Transparent" RightTapped="OnLayoutRoot_RightTapped">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="115"/>
        </Grid.RowDefinitions>

        <!-- ============ 顶部：相册标题（memories 标志右侧，不重叠） ============ -->
        <Grid x:Name="_panel_Header" Grid.Row="0" Margin="270,16,40,4" MinHeight="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" VerticalAlignment="Center">
                <TextBlock x:Name="_tb_Title"
                           Text="{Binding Title}"
                           FontFamily="Segoe UI Light"
                           FontSize="22"
                           Foreground="#FF313131"
                           TextTrimming="WordEllipsis"
                           VerticalAlignment="Center"/>
                <TextBox x:Name="_tb_TitleEdit"
                         Text="{Binding Title, Mode=TwoWay}"
                         FontSize="18"
                         Width="360"
                         Height="36"
                         Foreground="#FF313131"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         Visibility="Collapsed"/>
            </Grid>

            <StackPanel x:Name="viewModeButtons" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#1A000000" CornerRadius="3" Padding="10,5,10,5">
                    <TextBlock x:Name="_tb_PageCount" Foreground="#FF4A4A4A" FontSize="12"/>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ============ 中部：页视图（浏览 / 编辑 / 重排 共用这一个 GridView） ============ -->
        <Grid x:Name="_panel_Pages" Grid.Row="1">
            <Grid x:Name="_gridPlaceholder" HorizontalAlignment="Left" IsHitTestVisible="False" Opacity="0"/>

            <GridView x:Name="_pageView_Main"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      SelectionMode="None"
                      IsItemClickEnabled="False"
                      ItemContainerStyle="{StaticResource PageItemContainerStyle}"
                      ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                      ScrollViewer.VerticalScrollBarVisibility="Hidden"
                      ScrollViewer.HorizontalScrollMode="Enabled"
                      ScrollViewer.VerticalScrollMode="Disabled">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
            </GridView>
        </Grid>

        <!-- ============ 底部 AppBar：默认隐藏，右键滑出 ============ -->
        <Grid x:Name="_appbar" Grid.RowSpan="3" VerticalAlignment="Bottom"
              Height="88" Background="#FF1B1B1B" Opacity="1" Visibility="Collapsed">

            <TextBlock x:Name="_tb_AppBarHint" Text="Memories"
                       Margin="40,0,0,0" VerticalAlignment="Center"
                       FontFamily="Segoe UI Light" FontSize="20"
                       Foreground="#66FFFFFF" IsHitTestVisible="False"/>

            <!-- 所有按钮整体靠右；媒体相关的按钮排在页面按钮的左边（与原应用一致） -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,26,0">

                <!-- 空格被点中：Capture / Add -->
                <StackPanel x:Name="_appbar_MediaAdd" Orientation="Horizontal" Visibility="Collapsed">
                    <Button x:Name="_btn_Capture_Photo" Content="Capture" Tag="&#x25C9;" Style="{StaticResource AppBarBtn}"/>
                    <Button x:Name="_btn_Add" Content="Add" Tag="&#x002B;" Style="{StaticResource AppBarBtn}"/>
                </StackPanel>

                <!-- 已放置媒体被点中：Add Adorner / Crop Media / Change / Remove -->
                <StackPanel x:Name="_appbar_MediaEdit" Orientation="Horizontal" Visibility="Collapsed">
                    <Button x:Name="_btn_AddAdorner" Content="Add Adorner" Tag="&#x2605;" Style="{StaticResource AppBarBtn}"/>
                    <Button x:Name="_btn_CropMedia" Content="Crop Media" Tag="&#x25A3;" Style="{StaticResource AppBarBtn}"/>
                    <Button x:Name="_btn_Change" Content="Change" Tag="&#x27F3;" Style="{StaticResource AppBarBtn}"/>
                    <Button x:Name="_btn_Delete" Content="Remove" Tag="&#x2715;" Style="{StaticResource AppBarBtn}"/>
                </StackPanel>

                <!-- 浏览态：Edit -->
                <Button x:Name="_btn_EditMode" Content="Edit" Tag="&#x270E;" Style="{StaticResource AppBarBtn}"/>

                <!-- 编辑态：Add Page / Reorder Pages / Done -->
                <StackPanel x:Name="_appbar_Pages" Orientation="Horizontal" Visibility="Collapsed">
                    <Button x:Name="_btn_AddPage" Content="Add Page" Tag="&#x002B;" Style="{StaticResource AppBarBtn}"/>
                    <Button x:Name="_btn_ReorderPages" Content="Reorder Pages" Tag="&#x21C4;" Style="{StaticResource AppBarBtn}"/>
                    <Button x:Name="_btn_Done" Content="Done" Tag="&#x2713;" Style="{StaticResource AppBarBtn}"/>
                </StackPanel>

                <!-- 重排态：Delete Selected / Done -->
                <StackPanel x:Name="_appbar_Reorder" Orientation="Horizontal" Visibility="Collapsed">
                    <Button x:Name="_btn_DeleteSelected" Content="Delete Selected" Tag="&#x2715;" Style="{StaticResource AppBarBtn}"/>
                    <Button x:Name="_btn_ReorderDone" Content="Done" Tag="&#x2713;" Style="{StaticResource AppBarBtn}"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
