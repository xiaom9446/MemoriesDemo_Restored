                        <Image.RenderTransform>
                            <CompositeTransform/>
                        </Image.RenderTransform>
                    </Image>
                    <Rectangle x:Name="backgroundTextBox" Stretch="Fill" Fill="White" Height="44" Width="316" Margin="0,75,0,0" RenderTransformOrigin="0.5,0.5">
