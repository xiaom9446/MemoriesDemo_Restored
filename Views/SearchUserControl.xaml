                    <Grid Height="40" Width="40" Background="Transparent">
                        <Rectangle Stretch="Fill" Fill="#FFFFFFFF" Height="30" Width="30"/>
                        <Path Stretch="Fill" Fill="#FF000000" Data="F1 M 2646.14,-6001.58L 2641.06,-6006.65L 2635.99,-6001.58L 2634.22,-6003.36L 2639.29,-6008.43L 2634.22,-6013.5L 2635.99,-6015.27L 2641.06,-6010.2L 2646.14,-6015.27L 2647.91,-6013.5L 2642.84,-6008.43L 2647.91,-6003.36L 2646.14,-6001.58 Z " 
							Margin="8.22,7.73,8.09,8.58" UseLayoutRounding="False"/>
                    </Grid>
                </Button>
                <Button x:Name="_searchButton2" Style="{StaticResource ButtonStyle_Back}" VerticalAlignment="Top" Margin="388,52,0,0">
                    <Grid Background="Transparent" Height="138" Width="138">
                        <Grid x:Name="Search" Background="Transparent" Visibility="Collapsed">
                            <Image Source="/Assets/glowSearch.png" Height="138" Width="138" Opacity=".5" />
                            <Image Source="/Assets/Search_Glyph_Dark.png" Height="40" Width="40" />
                        </Grid>
                    </Grid>
                </Button>
                <ListView x:Name="_searchListView" Margin="34,100,3,0" Width="390"
                          IsItemClickEnabled="True"
                          CanDragItems="False"
                          CanReorderItems="False"
                          SelectionMode="Single">
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection>
                            <AddDeleteThemeTransition />
                            <ContentThemeTransition />
                            <ReorderThemeTransition />
                            <EntranceThemeTransition />
                        </TransitionCollection>
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="400">
                                <TextBlock Text="{Binding Title}" HorizontalAlignment="Left" Style="{StaticResource ContentTextStyle}" FontSize="23" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Caption}" HorizontalAlignment="Left" Style="{StaticResource ContentText2Style}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Popup>

        <Button x:Name="_searchButton" Style="{StaticResource ButtonStyle_Back}" Margin="0,-10,0,0">
            <Grid Background="Transparent">
                <Grid x:Name="Off" Height="138" Width="138">
                    <Image Source="/Assets/glowSearch.png" Height="138" Width="138" />
                    <Image Source="/Assets/Search_Glyph.png" Height="40" Width="40" />
                </Grid>
            </Grid>
        </Button>
    </Grid>
</UserControl>

