<UserControl 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:vsm='using:Windows.UI.Xaml'
    x:Class="MemoriesDemo.Views.AlbumItemTemplateView">

    <UserControl.Resources>
        <Storyboard x:Name="sb_TransitionIn">
            <DoubleAnimation From="0" To="1" Duration="0:0:0.5" Storyboard.TargetName="LayoutRoot" Storyboard.TargetProperty="Opacity">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Name="sb_TransitionOut">
            <DoubleAnimation From="1" To="0" Duration="0:0:0.25" Storyboard.TargetName="LayoutRoot" Storyboard.TargetProperty="Opacity">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Style x:Name="InnerTextBlockStyle_1" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="Margin" Value="16,0,8,0" />
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="FontFamily" Value="segoeuil.ttf#Segoe UI"/>
        </Style>
    </UserControl.Resources>

    <Viewbox Stretch="Fill">
        <Grid x:Name="LayoutRoot" Background="Transparent"
            Width="465" Height="475">
            <Grid.RenderTransform>
                <CompositeTransform/>
            </Grid.RenderTransform>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="EditingStates">
                    <VisualState x:Name="NotEditing">
                        <Storyboard>
                            <DoubleAnimation From="1" To="0" Duration="0:0:0.25" Storyboard.TargetName="_popup" Storyboard.TargetProperty="Opacity">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseIn" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)" Storyboard.TargetName="_popup">
                                <EasingDoubleKeyFrame KeyTime="0" Value="-20"/>
                                <EasingDoubleKeyFrame KeyTime="0:0:0.25" Value="0">
                                    <EasingDoubleKeyFrame.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </EasingDoubleKeyFrame.EasingFunction>
                                </EasingDoubleKeyFrame>
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimation From="0.5" To="1" Duration="0:0:0.25" Storyboard.TargetName="_panel_Pattern" Storyboard.TargetProperty="Opacity">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseIn" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Editing">
                        <Storyboard>
                            <DoubleAnimation From="0" To="1" Duration="0:0:0.25" Storyboard.TargetName="_popup" Storyboard.TargetProperty="Opacity">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseIn" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)" Storyboard.TargetName="_popup">
                                <EasingDoubleKeyFrame KeyTime="0" Value="0"/>
                                <EasingDoubleKeyFrame KeyTime="0:0:0.25" Value="-20">
                                    <EasingDoubleKeyFrame.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </EasingDoubleKeyFrame.EasingFunction>
                                </EasingDoubleKeyFrame>
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimation From="1" To="0.5" Duration="0:0:0.25" Storyboard.TargetName="_panel_Pattern" Storyboard.TargetProperty="Opacity">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseIn" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid x:Name="_panel_Large" Background="DarkGray" Grid.RowSpan="4" Grid.ColumnSpan="4" Width="455" Height="475"/>

            <Grid x:Name="_panel_Pattern"
              Width="455" Height="475">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid x:Name="_panel_Tile0" Grid.Row="0" Grid.Column="0" Background="#FF888888" Margin="5" />
                <Grid x:Name="_panel_Tile1" Grid.Row="1" Grid.Column="1" Background="#FF888888" Margin="5" />
                <Grid x:Name="_panel_Tile2" Grid.Row="2" Grid.Column="0" Grid.RowSpan="2" Grid.ColumnSpan="2" Background="#FFAAAAAA" Margin="5" />
                <Grid x:Name="_panel_Tile3" Grid.Row="0" Grid.Column="2" Grid.RowSpan="2" Grid.ColumnSpan="2" Background="#FFFF7D00" Margin="5,5,0,5" />
                <Grid x:Name="_panel_Tile4" Grid.Row="2" Grid.Column="2" Background="#FF888888" Margin="5" />
                <Grid x:Name="_panel_Tile5" Grid.Row="3" Grid.Column="2" Background="#FF888888" Margin="5" />
                <Grid x:Name="_panel_Tile6" Grid.Row="2" Grid.Column="3" Background="#FF888888" Margin="5,5,0,5" />
                <Grid x:Name="_panel_Tile7" Grid.Row="3" Grid.Column="3" Background="#FFFF7D00" Margin="5,5,0,5" />
            </Grid>

            <Popup x:Name="_popup" HorizontalAlignment="Center" Margin="5,-50,5,5" Canvas.Left="50" Opacity="0">
                <Popup.RenderTransform>
                    <CompositeTransform />
                </Popup.RenderTransform>
                <Grid x:Name="_popupChild">
                    <StackPanel Visibility="Collapsed">
                        <Border Background="#FF353535" Opacity=".85">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="18,11,18,11">
                                <Button x:Name="_btn_Delete" Content="Delete" />
                            </StackPanel>
                        </Border>
                        <Path Data="M-175,223 L-65,223 L-121.5,279.5 z" Fill="#FF353535" Opacity=".85" HorizontalAlignment="Center" Height="12" Stretch="Fill" UseLayoutRounding="False" VerticalAlignment="Top" Width="16"/>
                    </StackPanel>
                </Grid>
            </Popup>

        </Grid>
    </Viewbox>
</UserControl>

