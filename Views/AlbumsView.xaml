<Page x:Class="MemoriesDemo.Views.AlbumsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:MemoriesDemo.Views"
      xmlns:helpers="using:MemoriesDemo.Helpers">

    <Page.Resources>
        <helpers:DateConverter x:Key="DateConverter"/>

        <Storyboard x:Name="sb_TransitionIn">
            <DoubleAnimation From="0" To="1" Duration="0:0:0.5"
                             Storyboard.TargetName="LayoutRoot" Storyboard.TargetProperty="Opacity">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Name="sb_TransitionOut">
            <DoubleAnimation From="1" To="0" Duration="0:0:0.1"
                             Storyboard.TargetName="LayoutRoot" Storyboard.TargetProperty="Opacity">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Style x:Key="SelectedItemCountStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="56"/>
            <Setter Property="FontFamily" Value="Segoe UI Semilight"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Margin" Value="12,0,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="WordEllipsis"/>
        </Style>

        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF313131"/>
            <Setter Property="FontSize" Value="68"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="Margin" Value="73,71,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="Light"/>
        </Style>

        <!-- 相册卡片：上=拼贴图，下=115px 的标题/时间区（正对主页底部的黑色 band） -->
        <Style x:Key="ListViewItemStyle_Album" TargetType="ListViewItem">
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Grid x:Name="OuterContainer" Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="MouseOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="MouseOverBorder"
                                                             Storyboard.TargetProperty="Opacity"
                                                             Duration="0" To="1"/>
                                            <DoubleAnimation Duration="0:0:0.25" To="1"
                                                             Storyboard.TargetProperty="(UIElement.Opacity)"
                                                             Storyboard.TargetName="mouseOverGlow"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="contentPresenter"
                                                             Storyboard.TargetProperty="Opacity"
                                                             Duration="0" To=".55"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Focused">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="FocusedBorder"
                                                             Storyboard.TargetProperty="Opacity"
                                                             Duration="0" To="1"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Unfocused"/>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="SelectionStates">
                                    <VisualState x:Name="Selected">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SelectedBorder"
                                                             Storyboard.TargetProperty="Opacity"
                                                             Duration="0" To="1"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Unselected"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="115"/>
                            </Grid.RowDefinitions>

                            <!-- 拼贴图：只占黑条以上，不会再压到黑条 -->
                            <Grid x:Name="ContentContainer" Grid.Row="0" Margin="20,0,0,0">
                                <Grid x:Name="InnerDragContent">
                                    <Border x:Name="ContentBorder"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                        <ContentPresenter x:Name="contentPresenter"
                                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                                          Content="{TemplateBinding Content}"
                                                          HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Stretch"
                                                          Margin="{TemplateBinding Padding}"/>
                                    </Border>
                                </Grid>
                            </Grid>

                            <Border x:Name="MouseOverBorder" Grid.RowSpan="2"
                                    IsHitTestVisible="False" Opacity="0"
                                    BorderBrush="Transparent" BorderThickness="2"/>
                            <Border x:Name="SelectedBorder" Grid.RowSpan="2"
                                    IsHitTestVisible="False" Opacity="0"
                                    BorderBrush="#FFFF7D00" BorderThickness="2"/>
                            <Border x:Name="FocusedBorder" Grid.RowSpan="2"
                                    IsHitTestVisible="False" Opacity="0"
                                    BorderBrush="White" BorderThickness="2"/>

                            <!-- 标题 / 时间：落在黑条里；悬停时背后亮起一层光晕 -->
                            <Grid Grid.Row="1" Margin="20,0,0,0">
                                <!-- Win8 没有 RadialGradientBrush，用横向 + 纵向两层线性渐变叠加模拟柔光 -->
                                <Grid x:Name="mouseOverGlow" Height="115" Width="360"
                                      HorizontalAlignment="Left" Margin="0,0,12,0"
                                      VerticalAlignment="Bottom" Opacity="0" IsHitTestVisible="False">
                                    <Rectangle>
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                <GradientStop Color="#00FFFFFF" Offset="0"/>
                                                <GradientStop Color="#1CFFFFFF" Offset="0.35"/>
                                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <Rectangle>
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <GradientStop Color="#00FFFFFF" Offset="0"/>
                                                <GradientStop Color="#1CFFFFFF" Offset="0.5"/>
                                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                </Grid>
                                <StackPanel Margin="25,0,5,26" VerticalAlignment="Bottom">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="14" FontFamily="Segoe UI"
                                               Foreground="#FFB4B4B4" TextTrimming="WordEllipsis"/>
                                    <TextBlock Text="{Binding DateAdded, Converter={StaticResource DateConverter}}"
                                               FontSize="32" FontFamily="Segoe UI Light"
                                               Foreground="#FFDCDCDC" Margin="0,-2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ListViewItemStyle_AlbumGrid" TargetType="ListViewItem">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="150"/>
            <Setter Property="Width" Value="400"/>
            <Setter Property="Padding" Value="1"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Background" Value="LightGray"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Bottom"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- 底部 AppBar 的图标按钮：圆圈图标 + 下方文字 -->
        <Style x:Key="AppBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="110"/>
            <Setter Property="Height" Value="86"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Grid Width="40" Height="40" HorizontalAlignment="Center">
                                    <Ellipse x:Name="ring" Stroke="White" StrokeThickness="2" Opacity="0.9"/>
                                    <TextBlock Text="{TemplateBinding Tag}"
                                               FontFamily="Segoe UI Symbol" FontSize="18"
                                               Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="{TemplateBinding Content}"
                                           Foreground="White" FontSize="12"
                                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            </StackPanel>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="MouseOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ring"
                                                             Storyboard.TargetProperty="Opacity"
                                                             Duration="0:0:0.15" To="1"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ring"
                                                             Storyboard.TargetProperty="Opacity"
                                                             Duration="0" To="0.5"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ring"
                                                             Storyboard.TargetProperty="Opacity"
                                                             Duration="0" To="0.3"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>

    <Grid x:Name="LayoutRoot" Background="Transparent">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="GridViewStates">
                <VisualState x:Name="Browse">
                    <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="_gridView1" Storyboard.TargetProperty="Visibility">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                        </ObjectAnimationUsingKeyFrames>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="_gridView2" Storyboard.TargetProperty="Visibility">
                            <DiscreteObjectKeyFrame KeyTime="0:0:0.75" Value="Collapsed"/>
                        </ObjectAnimationUsingKeyFrames>
                        <DoubleAnimation From="0" To="1" Duration="0:0:0.5"
                                         Storyboard.TargetName="_gridView1" Storyboard.TargetProperty="Opacity">
                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation From="1" To="0" Duration="0:0:0.5"
                                         Storyboard.TargetName="_gridView2" Storyboard.TargetProperty="Opacity">
                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </VisualState>
                <VisualState x:Name="Grid">
                    <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="_gridView2" Storyboard.TargetProperty="Visibility">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                        </ObjectAnimationUsingKeyFrames>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="_gridView1" Storyboard.TargetProperty="Visibility">
                            <DiscreteObjectKeyFrame KeyTime="0:0:0.75" Value="Collapsed"/>
                        </ObjectAnimationUsingKeyFrames>
                        <DoubleAnimation From="0" To="1" Duration="0:0:0.5"
                                         Storyboard.TargetName="_gridView2" Storyboard.TargetProperty="Opacity">
                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation From="1" To="0" Duration="0:0:0.5"
                                         Storyboard.TargetName="_gridView1" Storyboard.TargetProperty="Opacity">
                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="_gridPlaceholder" Grid.Row="0"/>

        <Grid Grid.Row="0" Margin="5" x:Name="_panel_Header">
            <TextBlock Text="Gallery of Memories" Style="{StaticResource HeaderTextStyle}"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,0">
            <ListView x:Name="_gridView1"
                     Margin="0,-5,0,0"
                     ItemContainerStyle="{StaticResource ListViewItemStyle_Album}"
                     Background="Transparent"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Stretch"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollMode="Enabled"
                     ScrollViewer.IsHorizontalRailEnabled="True"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollMode="Disabled">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch"/>
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
            </ListView>

            <ListView x:Name="_gridView2"
                     Visibility="Collapsed"
                     Margin="0,0,0,0"
                     ItemContainerStyle="{StaticResource ListViewItemStyle_AlbumGrid}"
                     Background="Transparent"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Stretch"
                     BorderThickness="0"
                     Opacity="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.HorizontalScrollMode="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollMode="Enabled"
                     ScrollViewer.IsVerticalRailEnabled="True">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <local:AlbumItemSmallView/>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapGrid Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
            </ListView>
        </Grid>

        <Grid Grid.Row="1" Margin="-10,0,-20,0" VerticalAlignment="Bottom" HorizontalAlignment="Stretch">
            <Grid x:Name="_subPanel1" IsHitTestVisible="False">
                <Rectangle x:Name="_rectFade1" Stretch="Fill" Height="120" Width="250"
                           VerticalAlignment="Bottom" HorizontalAlignment="Left">
                    <Rectangle.Fill>
                        <LinearGradientBrush EndPoint="0.05,0.5" StartPoint="0.925,0.5">
                            <GradientStop Color="#FF313131" Offset="1"/>
                            <GradientStop Color="#00313131" Offset="0"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle x:Name="_rectFade2" Stretch="Fill" Height="120" Width="250"
                           VerticalAlignment="Bottom" HorizontalAlignment="Right">
                    <Rectangle.Fill>
                        <LinearGradientBrush EndPoint="0.05,0.5" StartPoint="0.925,0.5">
                            <GradientStop Color="#FF313131" Offset="0"/>
                            <GradientStop Color="#00313131" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </Grid>
        </Grid>

        <!-- ============ 点击遮罩：点空白处收起 AppBar ============ -->
        <Grid x:Name="_appbarScrim" Grid.RowSpan="2" Background="Transparent"
              Visibility="Collapsed" Tapped="OnAppBarScrim_Tapped"/>

        <!-- ============ 底部 AppBar：右键滑出，不再常驻显示 ============ -->
        <Grid x:Name="_appbar" Grid.Row="1" VerticalAlignment="Bottom" Height="96"
              Background="#FF1B1B1B" Visibility="Collapsed">
            <Grid.RenderTransform>
                <CompositeTransform TranslateY="96"/>
            </Grid.RenderTransform>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="_tb_AppBarHint" Grid.Column="0" Text="Gallery of Memories"
                       Margin="48,0,0,0" VerticalAlignment="Center"
                       FontFamily="Segoe UI Light" FontSize="22" Foreground="#FF9A9A9A"/>

            <!-- 默认菜单 -->
            <StackPanel x:Name="_panel_MainMenu" Grid.Column="1" Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="0,0,32,0">
                <Button x:Name="_btn_Browse" Content="List" Tag="&#x2630;" Style="{StaticResource AppBarButtonStyle}"/>
                <Button x:Name="_btn_Grid" Content="Grid" Tag="&#x229E;" Style="{StaticResource AppBarButtonStyle}"/>
                <Button x:Name="_btn_NewAlbum" Content="New Album" Tag="&#x002B;" Style="{StaticResource AppBarButtonStyle}"/>
                <Button x:Name="_btn_GenerateAlbum" Content="Generate Album" Tag="&#x2713;" Style="{StaticResource AppBarButtonStyle}"/>
            </StackPanel>

            <!-- 选中某个相册后（右键卡片）显示的菜单 -->
            <StackPanel x:Name="_panel_AlbumMenu" Grid.Column="1" Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="0,0,32,0" Visibility="Collapsed">
                <Button x:Name="_btn_DeleteAlbum" Content="Delete Album" Tag="&#x2716;" Style="{StaticResource AppBarButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>