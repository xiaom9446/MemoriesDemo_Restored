<UserControl x:Class="MemoriesDemo.Views.EditMediaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Storyboard x:Name="sb_TransitionIn">
            <DoubleAnimation From="0" To="1" Duration="0:0:0.5"
                             Storyboard.TargetName="LayoutRoot" Storyboard.TargetProperty="Opacity">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Name="sb_TransitionOut">
            <DoubleAnimation From="1" To="0" Duration="0:0:0.5"
                             Storyboard.TargetName="LayoutRoot" Storyboard.TargetProperty="Opacity">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Name="_sb_TransitionGridViewIn">
            <DoubleAnimation From="0" To="1" Duration="0:0:0.3"
                             Storyboard.TargetName="_gridView1" Storyboard.TargetProperty="Opacity">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Name="_sb_TransitionGridViewOut">
            <DoubleAnimation From="1" To="0" Duration="0:0:0.3"
                             Storyboard.TargetName="_gridView1" Storyboard.TargetProperty="Opacity">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- AppBar 风格的图标按钮：圆圈 + 图形 + 文字 -->
        <Style x:Key="AdornerBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="96"/>
            <Setter Property="Height" Value="68"/>
            <Setter Property="Margin" Value="2,0,2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="MouseOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ring"
                                                             Storyboard.TargetProperty="Opacity"
                                                             Duration="0:0:0.15" To="0.45"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ring"
                                                             Storyboard.TargetProperty="Opacity"
                                                             Duration="0" To="0.7"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Grid Width="36" Height="36" HorizontalAlignment="Center">
                                    <Ellipse x:Name="ring" Stroke="White" StrokeThickness="1.6" Opacity="0.9"/>
                                    <TextBlock Text="{TemplateBinding Tag}"
                                               FontFamily="Segoe UI Symbol" FontSize="15"
                                               Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="{TemplateBinding Content}"
                                           Foreground="White" FontSize="11.5"
                                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AdornerModeStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#CCFFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,24,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="MouseOver"/>
                                    <VisualState x:Name="Pressed"/>
                                    <VisualState x:Name="Disabled"/>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Checked">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="underline"
                                                             Storyboard.TargetProperty="Opacity"
                                                             Duration="0:0:0.2" To="1"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="underline"
                                                             Storyboard.TargetProperty="Opacity"
                                                             Duration="0:0:0.2" To="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Indeterminate"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Content}"
                                           Foreground="#CCFFFFFF" FontSize="14"/>
                                <Rectangle x:Name="underline" Height="2" Fill="#FFFF7D00"
                                           Opacity="0" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PropTileStyle" TargetType="ListViewItem">
            <Setter Property="Height" Value="88"/>
            <Setter Property="Width" Value="88"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="LayoutRoot" Background="Transparent" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="88"/>
        </Grid.RowDefinitions>

        <!-- 全屏遮罩 -->
        <Grid Grid.RowSpan="2" Background="#E6000000"/>

        <!-- ============ 左：待编辑图片；右：装饰素材 ============ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="40,24,20,12">
                <Border BorderBrush="#33FFFFFF" BorderThickness="1" Opacity="0.9"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Viewbox Stretch="Uniform" MaxWidth="640" MaxHeight="520">
                        <Grid x:Name="_panelEditCanvas"
                              Width="700" Height="700"
                              Background="Transparent"
                              AllowDrop="True"/>
                    </Viewbox>
                </Border>
            </Grid>

            <Grid Grid.Column="1" Margin="20,24,32,12">
                <ListView x:Name="_gridView1"
                          Background="Transparent"
                          ItemContainerStyle="{StaticResource PropTileStyle}"
                          BorderThickness="0"
                          AllowDrop="False"
                          CanDragItems="True"
                          CanReorderItems="False"
                          SelectionMode="None"
                          IsItemClickEnabled="False"
                          VerticalAlignment="Stretch"
                          HorizontalAlignment="Stretch"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapGrid Orientation="Horizontal"
                                      HorizontalChildrenAlignment="Left"
                                      VerticalChildrenAlignment="Top"/>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                </ListView>
            </Grid>
        </Grid>

        <!-- ============ 底部工具条 ============ -->
        <Grid Grid.Row="1" Background="#FF1B1B1B">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="40,0,0,0">
                <RadioButton x:Name="_btn_Props" Content="Props" Style="{StaticResource AdornerModeStyle}"/>
                <RadioButton x:Name="_btn_Scenes" Content="Scenes" Style="{StaticResource AdornerModeStyle}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="0,0,26,0">
                <Button x:Name="_btn_Undo" Content="Reset" Tag="&#x21BA;" Style="{StaticResource AdornerBarButtonStyle}"/>
                <Button x:Name="_btn_Save" Content="Save" Tag="&#x2713;" Style="{StaticResource AdornerBarButtonStyle}"/>
                <Button x:Name="_btn_Cancel" Content="Cancel" Tag="&#x2715;" Style="{StaticResource AdornerBarButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
