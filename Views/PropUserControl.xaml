<UserControl 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:vsm='using:Windows.UI.Xaml'
    x:Class="MemoriesDemo.Views.PropUserControl"
    >
    <UserControl.Resources>
        <Storyboard x:Name="sb_TransitionIn">
            <DoubleAnimation From="0" To="1" Duration="0:0:0.5" Storyboard.TargetName="LayoutRoot" Storyboard.TargetProperty="Opacity">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateX)" Storyboard.TargetName="LayoutRoot">
                <EasingDoubleKeyFrame KeyTime="0" Value="500"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <Storyboard x:Name="sb_TransitionOut">
            <DoubleAnimation From="1" To="0" Duration="0:0:0.5" Storyboard.TargetName="LayoutRoot" Storyboard.TargetProperty="Opacity">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>


    </UserControl.Resources>

    <Grid x:Name="LayoutRoot" >
        <Grid.Resources>
        </Grid.Resources>
        <Grid.RenderTransform>
            <CompositeTransform/>
        </Grid.RenderTransform>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="EditingStates">
                <VisualState x:Name="NotEditing">
                    <Storyboard>
                        <DoubleAnimation From="1" To="0" Duration="0:0:0.25" Storyboard.TargetName="_popup" Storyboard.TargetProperty="Opacity">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseIn" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)" Storyboard.TargetName="_popup">
                            <EasingDoubleKeyFrame KeyTime="0" Value="-20"/>
                            <EasingDoubleKeyFrame KeyTime="0:0:0.25" Value="0">
                                <EasingDoubleKeyFrame.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </EasingDoubleKeyFrame.EasingFunction>
                            </EasingDoubleKeyFrame>
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>
                <VisualState x:Name="Editing">
                    <Storyboard>
                        <DoubleAnimation From="0" To="1" Duration="0:0:0.25" Storyboard.TargetName="_popup" Storyboard.TargetProperty="Opacity">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseIn" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)" Storyboard.TargetName="_popup">
                            <EasingDoubleKeyFrame KeyTime="0" Value="0"/>
                            <EasingDoubleKeyFrame KeyTime="0:0:0.25" Value="-20">
                                <EasingDoubleKeyFrame.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </EasingDoubleKeyFrame.EasingFunction>
                            </EasingDoubleKeyFrame>
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Image x:Name="_image" />

        <Canvas x:Name="_popupRoot" Background="Transparent" IsHitTestVisible="False">
            <Popup x:Name="_popup" HorizontalAlignment="Center" Margin="-90,-5,5,5" Canvas.Left="50" Opacity="0">
                <Popup.RenderTransform>
                    <CompositeTransform />
                </Popup.RenderTransform>
                <Grid x:Name="_popupChild">
                    <StackPanel>
                        <Border Background="#FF353535" Opacity=".85">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="18,11,18,11">
                                <Button x:Name="_btn_ScaleUp" Content="Scale up" Height="50" Margin="10" />
                                <Button x:Name="_btn_ScaleDown" Content="Scale down" Height="50" Margin="10" />
                                <Button x:Name="_btn_Delete" Content="Remove" Height="50" Margin="10" />
                            </StackPanel>
                        </Border>
                        <Path Data="M-175,223 L-65,223 L-121.5,279.5 z" Fill="#FF353535" Opacity=".85" HorizontalAlignment="Center" Height="15" Stretch="Fill" UseLayoutRounding="False" VerticalAlignment="Top" Width="16"/>
                    </StackPanel>
                </Grid>
            </Popup>
        </Canvas>
    </Grid>
</UserControl>

