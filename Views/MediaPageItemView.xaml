<UserControl 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:vsm='using:Windows.UI.Xaml'
    x:Class="MemoriesDemo.Views.MediaPageItemView"
    >
    <UserControl.Resources>
        <Storyboard x:Name="sb_TransitionIn">
            <DoubleAnimation From="0" To="1" Duration="0:0:0.5" Storyboard.TargetName="LayoutRoot" Storyboard.TargetProperty="Opacity">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Name="sb_TransitionOut">
            <DoubleAnimation From="1" To="0" Duration="0:0:0.25" Storyboard.TargetName="LayoutRoot" Storyboard.TargetProperty="Opacity">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <Grid x:Name="LayoutRoot" Background="Transparent">
        <Grid.RenderTransform>
            <CompositeTransform/>
        </Grid.RenderTransform>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="EditingStates">
                <VisualState x:Name="NotEditing">
                    <Storyboard>
                        <DoubleAnimation From="1" To="0" Duration="0:0:0.25" Storyboard.TargetName="_popup" Storyboard.TargetProperty="Opacity">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseIn" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)" Storyboard.TargetName="_popup">
                            <EasingDoubleKeyFrame KeyTime="0" Value="-20"/>
                            <EasingDoubleKeyFrame KeyTime="0:0:0.25" Value="0">
                                <EasingDoubleKeyFrame.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </EasingDoubleKeyFrame.EasingFunction>
                            </EasingDoubleKeyFrame>
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>
                <VisualState x:Name="Editing">
                    <Storyboard>
                        <DoubleAnimation From="0" To="1" Duration="0:0:0.25" Storyboard.TargetName="_popup" Storyboard.TargetProperty="Opacity">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseIn" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)" Storyboard.TargetName="_popup">
                            <EasingDoubleKeyFrame KeyTime="0" Value="0"/>
                            <EasingDoubleKeyFrame KeyTime="0:0:0.25" Value="-20">
                                <EasingDoubleKeyFrame.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </EasingDoubleKeyFrame.EasingFunction>
                            </EasingDoubleKeyFrame>
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="SelectionStates">
                <VisualState x:Name="Selected">
                    <Storyboard>
                        <DoubleAnimation From="0" To="1" Duration="0:0:0.25" Storyboard.TargetName="_border_Selection" Storyboard.TargetProperty="Opacity">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseIn" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </VisualState>
                <VisualState x:Name="Unselected">
                    <Storyboard>
                        <DoubleAnimation From="1" To="0" Duration="0:0:0.25" Storyboard.TargetName="_border_Selection" Storyboard.TargetProperty="Opacity">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseIn" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Border x:Name="_border_Selection" BorderThickness="2" BorderBrush="Blue" Opacity="0">
        </Border>

        <!--This is where the media is inserted-->
        <Grid x:Name="_panel_Media" Background="#FF888888" Margin="3" /> 
        
        <Grid x:Name="_panel_PlayMedia" Visibility="Collapsed" IsHitTestVisible="False" Background="Black" Opacity="0.75">
            <Button Style="{StaticResource ButtonStyle_Play}" Content="Play" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>

        <Grid x:Name="_panel_AddPhoto" Background="DarkGray" Margin="3">
            <Border BorderThickness="1" BorderBrush="Black">
                <TextBlock x:Name="_tb_AddPhoto" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17" Visibility="Visible" Text="Add Media" />
            </Border>
        </Grid>

        <Canvas Background="Transparent">
            <Popup x:Name="_popup" HorizontalAlignment="Center" Margin="-90,-56,5,5" Canvas.Left="50" Opacity="0">
                <Popup.RenderTransform>
                    <CompositeTransform />
                </Popup.RenderTransform>
                <Grid x:Name="_popupChild">
                    <StackPanel>
                        <Border Background="#FF353535" Opacity=".85">
                            <Grid>
                                <StackPanel x:Name="_panel_Edit" Orientation="Horizontal" HorizontalAlignment="Center" Margin="18,11,18,11" Visibility="Collapsed">
                                    <Button x:Name="_btn_Edit" Content="Add Adorner" Height="50" Margin="10" />
                                    <Button x:Name="_btn_Change" Content="Change" Height="50" Margin="10" />
                                    <Button x:Name="_btn_Delete" Content="Remove" Height="50" Margin="10" />
                                </StackPanel>

                                <StackPanel x:Name="_panel_Add" Orientation="Horizontal" HorizontalAlignment="Center" Margin="18,11,18,11">
                                    <Button x:Name="_btn_Capture_Photo" Content="Capture" Height="50" Margin="10" />
                                    <Button x:Name="_btn_Add" Content="Add" Height="50" Margin="10" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Path Data="M-175,223 L-65,223 L-121.5,279.5 z" Fill="#FF353535" Opacity=".85" HorizontalAlignment="Center" Height="15" Stretch="Fill" UseLayoutRounding="False" VerticalAlignment="Top" Width="16"/>
                    </StackPanel>
                </Grid>
            </Popup>
        </Canvas>
    </Grid>
</UserControl>

